            "state": "translated",
            "value": "Wecker"
          }
        }
      }
    },
    "Alarms already armed still ring. Kathlender tries again the next time you open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits gestellte Wecker klingeln weiterhin. Kathlender versucht es beim nächsten Öffnen erneut."
          }
        }
      }
    },
    "Alarms couldn't be armed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker konnten nicht gestellt werden"
          }
        }
      }
    },
    "Alarms ring through silent mode and Focus, even when this app is closed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker klingeln auch im Stummmodus und bei aktivem Fokus, selbst wenn die App geschlossen ist."
          }
        }
      }
    },
    "Alarms that follow your roster": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker, die deinem Dienstplan folgen"
          }
        }
      }
    },
    "All-day events titled “%@”, in any case, in your chosen calendars become %@ Shifts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganztägige Termine mit dem Titel „%1$@“ in deinen ausgewählten Kalendern werden als %2$@ erkannt, egal in welcher Schreibweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All-day events titled “%1$@”, in any case, in your chosen calendars become %2$@ Shifts."
          }
        }
      }
    },
    "All-day events titled “%@”, in any case, in your chosen calendars become these Shifts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganztägige Termine mit dem Titel „%@“ in deinen ausgewählten Kalendern werden als diese Dienste erkannt, egal in welcher Schreibweise."
          }
        }
      }
    },
